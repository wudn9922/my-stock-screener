# ===== Supabase（每日掃描 main.py、突破監控 breakout_alert）=====
SUPABASE_URL=
# 突破監控使用；每日掃描未設定時會退回 SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# 要讀取哪位使用者的自選股（未設定時退回 LINE_USER_ID）
SUPABASE_USER_ID=

# ===== LINE Messaging API（每日報告推播）=====
LINE_ACCESS_TOKEN=
# 推播對象的 User ID，必須以 U 開頭
LINE_USER_ID=

# ===== Discord（突破通知與查詢）=====
DISCORD_WEBHOOK_URL=
DISCORD_PUBLIC_KEY=

# ===== 突破監控 /run 驗證（選用）=====
# 設定後，呼叫端必須帶 X-Run-Token 標頭；留空則不驗證
RUN_TOKEN=

# ===== dify_report.py（華爾街報告）=====
DIFY_API_KEY=
FRED_API_KEY=
FED_TARGET_LOWER_FALLBACK=
FED_TARGET_UPPER_FALLBACK=

# ===== 選用 =====
# true 時，自訂群組只要能下載就顯示，不套用均線距離條件
CUSTOM_GROUP_TEST_MODE=false
