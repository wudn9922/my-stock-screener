{
  "name": "atlas-terminal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-server.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "test:browser": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "serve:fundamentals": "node dist-server/fundamentals.mjs",
    "test:sec-live": "node scripts/sec-smoke.mjs"
  },
  "dependencies": {
    "@tradingview/lwc-toolkit": "1.0.0",
    "fancy-canvas": "^2.1.0",
    "idb": "^8.0.3",
    "lightweight-charts": "5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "^7.30.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
